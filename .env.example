APP_NAME=Hurricane Week Backend
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
ALLOWED_ORIGINS=http://localhost:3000

# Tiger Data / TimescaleDB (wire in Sprint 3+)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hurricaneweek

# AI and audio integrations (optional for local MVP)
# Gemini generates the personalized "plan_text" field on the final report -
# a short action plan based on the player's actual decisions. Get a free key
# at https://aistudio.google.com (no billing required).
GEMINI_API_KEY=
GEMINI_MODEL=
# ElevenLabs generates a spoken debrief narration for the final report.
# Voice ID defaults to "George" (JBFqnCBsd6RMkjVDRZzb) if left unset -
# free-tier accounts can only use voices in their own voice list, not
# the full shared library, so check `GET /v1/voices` before changing this.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional stretch integrations
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WALLET_PRIVATE_KEY=

MONGODB_URI=
