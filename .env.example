APP_NAME=Hurricane Week Backend
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
ALLOWED_ORIGINS=http://localhost:3000

# Postgres connection string (Tiger Cloud/Timescale in production; any local
# Postgres works for development, though the hypertable/continuous-aggregate
# setup only activates on TimescaleDB). Writes one telemetry row per decision
# to `simulation_telemetry`, read back by the timeline endpoint.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hurricaneweek

# AI and audio integrations (optional for local MVP)
# Gemini generates the personalized "plan_text" field on the final report -
# a short action plan based on the player's actual decisions. Get a free key
# at https://aistudio.google.com (no billing required).
GEMINI_API_KEY=
GEMINI_MODEL=
# ElevenLabs generates a spoken debrief narration for the final report.
# Voice ID defaults to "George" (JBFqnCBsd6RMkjVDRZzb) if left unset -
# free-tier accounts can only use voices in their own voice list, not
# the full shared library, so check `GET /v1/voices` before changing this.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Snowflake backs the Readiness Assistant: real FEMA/NOAA facts plus Cortex
# AI (RAG + AI_COMPLETE) for grounded answers. Falls back to Gemini
# (GEMINI_API_KEY above) if Cortex is unavailable (e.g. trial accounts).
# SNOWFLAKE_PAT is a Programmatic Access Token, not a password - generate one
# from the Snowflake UI under your user's "Programmatic access tokens".
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
SNOWFLAKE_ROLE=HW_APP
SNOWFLAKE_WAREHOUSE=HW_WH
SNOWFLAKE_FACTS_TABLE=HURRICANE_WEEK.APP.FACTS
SNOWFLAKE_KNOWLEDGE_TABLE=HURRICANE_WEEK.APP.KNOWLEDGE
SNOWFLAKE_CORTEX_MODEL=llama3.1-70b
SNOWFLAKE_EMBED_MODEL=snowflake-arctic-embed-m-v1.5
# "cortex" (default) tries Snowflake Cortex first, falling back to Gemini;
# set to "gemini" to skip Cortex entirely.
ASSISTANT_LLM=

# Records a memo transaction on Solana devnet when a simulation completes
# (outcome + score, verifiable on Solana Explorer). SOLANA_WALLET_SECRET_B64
# is the base64-encoded 64-byte secret key from solders' Keypair.to_bytes().
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WALLET_SECRET_B64=

# Persists active simulation state in MongoDB Atlas instead of a process-local
# dict, so simulations survive backend restarts/redeploys. Falls back to the
# in-memory store automatically if unset or unreachable.
MONGODB_URI=
